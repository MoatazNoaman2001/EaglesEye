<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
    <!-- EaglesEye dev — Traccar as protocol bridge (ADR-9). DEV configuration only. -->

    <!-- Embedded H2: Traccar's DB is a short-lived buffer; TimescaleDB is the system of record. -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- DEV ONLY: auto-create unknown devices so simulated frames flow immediately.
         Production tightens this via registry sync + rejection (T-205, FR-ING-06). -->
    <entry key='database.registerUnknown'>true</entry>

    <!-- DEV ONLY: API service-account token for automation (registry sync T-205 uses this pattern).
         Production tokens come from the vault, never from files in git. -->
    <entry key='web.serviceAccountToken'>ee-dev-service-token</entry>

    <!-- ADR-9: forward every decoded position into our Kafka (internal listener) -->
    <entry key='forward.type'>kafka</entry>
    <entry key='forward.url'>kafka:19092</entry>
    <entry key='forward.topic'>traccar.positions</entry>
    <entry key='forward.retry.enable'>true</entry>
    <entry key='forward.retry.count'>10</entry>

    <!-- events too — everything on the bus, consumers or not (AO-03) -->
    <entry key='event.forward.type'>kafka</entry>
    <entry key='event.forward.url'>kafka:19092</entry>
    <entry key='event.forward.topic'>traccar.events</entry>
</properties>
