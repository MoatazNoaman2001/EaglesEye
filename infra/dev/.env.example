# EaglesEye dev stack — environment contract (T-106 / NFR-08)
# Copy to .env in this directory and adjust. The .env file is gitignored; this example is the contract.
# These are LOCAL DEV credentials only. Staging/production secrets come from the vault, never from files in git.

# TimescaleDB
EE_DB_NAME=eagleseye
EE_DB_USER=eagleseye
EE_DB_PASSWORD=eagleseye-dev

# Keycloak bootstrap admin (dev mode)
EE_KC_ADMIN_USER=admin
EE_KC_ADMIN_PASSWORD=admin

# Traccar bridge admin + service token (dev)
# EE_TRACCAR_TOKEN must match web.serviceAccountToken in traccar/traccar.xml
EE_TRACCAR_TOKEN=ee-dev-service-token
EE_TRACCAR_ADMIN_EMAIL=admin@eagleseye.local
EE_TRACCAR_ADMIN_PASSWORD=eagleseye-dev

# App database role (RLS-bound, created by migration V8; dev values)
EE_DB_APP_USER=eagleseye_app
EE_DB_APP_PASSWORD=eagleseye-app-dev
